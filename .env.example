# ====================================================================
# MindCare AI — Environment Configuration Example
# ====================================================================
# Copy this file to .env and configure keys as appropriate.
# The system operates out-of-the-box in Demonstration Mode with mock providers
# if external API keys or cloud credentials are not supplied.
# ====================================================================

# Application Settings
APP_NAME="MindCare AI — Smart Mental Wellness Companion"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY="replace-with-a-secure-random-jwt-secret-in-production"

# AI Provider Configuration ("gemini" or "mock")
# When AI_PROVIDER=gemini, GEMINI_API_KEY must be provided.
# If invalid or omitted, backend gracefully falls back to MockAIProvider.
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# Voice Provider Configuration
VOICE_PROVIDER=mock
STT_PROVIDER=mock          # "gemini", "whisper", or "mock"
TTS_PROVIDER=mock          # "gemini", "local", or "mock"
VOICE_MODE=standard        # "standard" or "realtime"
REALTIME_VOICE_ENABLED=true

# Wearable Provider Configuration ("mock" or "external")
# "mock" runs the realistic MockWearableProvider generating diurnal rhythms and exercise bouts.
WEARABLE_PROVIDER=mock

# Firebase / Cloud Firestore Configuration (Optional)
# If omitted or invalid, backend uses the built-in thread-safe Local Persistent Store.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_DATABASE_URL=
USE_FIREBASE_EMULATOR=false

# Physiological Baseline & Contextual Anomaly Thresholds
HR_REST_LOW_THRESHOLD=48
HR_REST_HIGH_THRESHOLD=100
HR_SLEEP_HIGH_THRESHOLD=85
HR_EXERCISE_MAX_NORMAL=185
SLEEP_MIN_DURATION_HOURS=5.0
STRESS_HIGH_THRESHOLD=8

# Safety & Crisis Intervention
SAFETY_ALERT_EMAIL=safety-team@mindcare.internal
CRISIS_LIFELINE_PHONE=988
CRISIS_TEXT_LINE="HOME to 741741"
CRISIS_INTERNATIONAL_URL=https://findahelpline.com

